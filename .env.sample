# --- OpenAI (API_KEY is accepted as an alias) ---
OPENAI_API_KEY=sk-...
# Leave empty on first run: a store named VECTOR_STORE_NAME is found or created.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb
OPENAI_MODEL=gpt-4.1-mini

# --- Zendesk help center to scrape ---
HELP_CENTER_URL=https://support.optisigns.com
HELP_CENTER_LOCALE=en-us
# 0 = scrape every article
MAX_ARTICLES=0
OUTPUT_DIR=articles
